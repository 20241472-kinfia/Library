@using library.Models
@model Member
@{
    ViewData["Name"] = "Delete a member";
}

<h1 class="mb-3">Delete a member</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this book?</p>
    <dl class="row mb-2">
        <dt class="col-4">Name</dt>
        <dd class="col-8">@Model.Name</dd>
        <dt class="col-4">Category</dt>
        <dd class="col-8">@(Model.Type ?? "—")</dd>
        <dt class="col-4">Price</dt>
        <dd class="col-8">@(Model.Email?? "—")</dd>
    </dl>
    <p class="text-muted small">Any loans of this member are deleted with it.</p>

    <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

